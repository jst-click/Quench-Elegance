# ---------- Server ----------
ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API
CLIENT_ORIGINS=http://localhost:5173

# ---------- PostgreSQL ----------
# Create the database first:  CREATE DATABASE quench_elegance;
# Replace YOUR_PASSWORD with your PostgreSQL password
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/quench_elegance

# ---------- Security ----------
# Use a long random string in production (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-this-to-a-long-random-secret

# ---------- First admin (created automatically if no admin exists) ----------
ADMIN_EMAIL=admin@quenchelegance.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Quench Admin

# ---------- OTP / Fast2SMS ----------
# console  -> OTP printed in the server log (testing)
# fast2sms -> real SMS via Fast2SMS
OTP_PROVIDER=fast2sms
# true = OTP is also shown on the login screen, and if the SMS fails the OTP still works (testing only).
# Set to false in production once SMS delivery is confirmed.
OTP_DEV_MODE=true
# must match the DLT template text ("Valid for 10 minutes")
OTP_EXPIRY_MINUTES=10
# Default OTP: also accepted at login for any registered, active customer (alongside the real SMS OTP).
# Anyone who knows it can log in as any customer - leave empty to disable.
OTP_MASTER_CODE=

# Fast2SMS API key: fast2sms.com -> Dev API
FAST2SMS_API_KEY=
# "dlt" = your own DLT-approved template (needs sender ID + Fast2SMS message ID)
# "otp" = Fast2SMS quick OTP route (no DLT needed)
FAST2SMS_ROUTE=dlt
# DLT template: "Your OTP for Quench Elegance verification is {#VAR#}. Please do not share this OTP
# with anyone. Valid for 10 minutes -Quench Elegance"   (Service, EN)
FAST2SMS_SENDER_ID=QUELEG
# Fast2SMS "Message ID" from DLT Manager (NOT the 19-digit DLT Template ID)
FAST2SMS_TEMPLATE_ID=232089

# ---------- Store ----------
SHIPPING_FLAT=0
FREE_SHIPPING_ABOVE=0
