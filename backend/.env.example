# ---------- Server ----------
ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API
CLIENT_ORIGINS=http://localhost:5173

# ---------- PostgreSQL ----------
# Create the database first:  CREATE DATABASE quench_elegance;
# Replace YOUR_PASSWORD with your PostgreSQL password
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/quench_elegance

# ---------- Security ----------
# Use a long random string in production (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-this-to-a-long-random-secret

# ---------- First admin (created automatically if no admin exists) ----------
ADMIN_EMAIL=admin@quenchelegance.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Quench Admin

# ---------- OTP / Fast2SMS ----------
# console  -> OTP printed in the server log (testing)
# fast2sms -> real SMS via Fast2SMS
OTP_PROVIDER=console
# true = OTP is also shown on the login screen (testing only - set false in production)
OTP_DEV_MODE=true
OTP_EXPIRY_MINUTES=5

# Fast2SMS API key: fast2sms.com -> Dev API
FAST2SMS_API_KEY=
# "otp" = Fast2SMS quick OTP route (no DLT needed)
# "dlt" = your own DLT-approved template (needs sender ID + message/template ID)
FAST2SMS_ROUTE=otp
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=

# ---------- Store ----------
SHIPPING_FLAT=0
FREE_SHIPPING_ABOVE=0
